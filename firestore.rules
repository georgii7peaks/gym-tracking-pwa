rules_version = '2';

// Phase 4 (IMPLEMENTATION_PLAN.md §5): a signed-in user reads/writes only
// their own subtree. No cross-user access, no anonymous access. Firestore is
// online-only and explicit push/pull (never a live listener), so this is the
// entire access-control surface for cloud sync.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
